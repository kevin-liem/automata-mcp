{
  "name": "claude-whatsapp-mcp",
  "version": "1.3.2",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "generate": "pnpm --filter web generate",
    "typecheck": "pnpm --filter web typecheck",
    "test:emails": "node --test apps/web/test/emails.test.mjs",
    "test:media": "node --test apps/web/test/whatsapp-media.test.mjs apps/web/test/media-download.test.mjs",
    "test:oauth": "node --env-file-if-exists=.env --test apps/web/test/oauth.test.mjs",
    "bridge:dev": "pnpm --filter telegram-bridge dev",
    "bridge:typecheck": "pnpm --filter telegram-bridge typecheck",
    "cloud:dev": "pnpm --filter cloud dev",
    "cloud:typecheck": "pnpm --filter cloud typecheck",
    "cloud:crm-backfill": "pnpm --filter cloud crm-backfill",
    "release:version": "node .github/scripts/listings.mjs version",
    "listings:check": "node .github/scripts/listings.mjs check",
    "listings:tools": "node .github/scripts/listings.mjs tools",
    "services:up": "docker compose -f docker-compose.dev.yml up -d",
    "services:up:whatsapp": "docker compose -f docker-compose.dev.yml --profile whatsapp up -d",
    "services:up:telegram": "docker compose -f docker-compose.dev.yml --profile telegram up -d",
    "services:down": "docker compose -f docker-compose.dev.yml --profile whatsapp --profile telegram down",
    "services:logs": "docker compose -f docker-compose.dev.yml --profile whatsapp --profile telegram logs -f",
    "services:ps": "docker compose -f docker-compose.dev.yml --profile whatsapp --profile telegram ps"
  }
}
